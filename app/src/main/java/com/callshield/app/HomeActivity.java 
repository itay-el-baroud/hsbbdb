package com.callshield.app;

import android.Manifest;
import android.app.role.RoleManager;
import android.content.ClipData;
import android.content.ClipboardManager;
import android.content.Context;
import android.content.Intent;
import android.content.pm.PackageManager;
import android.os.Build;
import android.os.Bundle;
import android.text.Editable;
import android.text.TextWatcher;
import android.view.MenuItem;
import android.view.View;
import android.widget.ArrayAdapter;
import android.widget.Button;
import android.widget.EditText;
import android.widget.ListView;
import android.widget.ProgressBar;
import android.widget.Spinner;
import android.widget.Switch;
import android.widget.TextView;
import android.widget.Toast;
import android.widget.ViewFlipper;

import androidx.annotation.NonNull;
import androidx.appcompat.app.AlertDialog;
import androidx.appcompat.app.AppCompatActivity;
import androidx.appcompat.app.AppCompatDelegate;

import com.google.android.material.bottomnavigation.BottomNavigationView;

import java.util.ArrayList;
import java.util.List;

public class HomeActivity extends AppCompatActivity {

    private StorageManager storage;
    private ViewFlipper flipper;
    private ListView listBlocked;
    private ListView listLogs;
    private EditText searchBox;
    private ProgressBar progressHome;
    private TextView textProfile;
    private List<String[]> allBlocked = new ArrayList<>();

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_home);

        storage = StorageManager.getInstance(this);
        flipper = findViewById(R.id.flipper);
        listBlocked = findViewById(R.id.list_blocked);
        listLogs = findViewById(R.id.list_logs);
        searchBox = findViewById(R.id.search_box);
        progressHome = findViewById(R.id.progress_home);
        textProfile = findViewById(R.id.text_profile);

        BottomNavigationView navView = findViewById(R.id.nav_view);
        navView.setOnItemSelectedListener(new BottomNavigationView.OnItemSelectedListener() {
            @Override
            public boolean onNavigationItemSelected(@NonNull MenuItem item) {
                int id = item.getItemId();
                if (id == R.id.navigation_blocked) {
                    refreshBlocked(searchBox.getText().toString());
                    flipper.setDisplayedChild(0);
                } else if (id == R.id.navigation_logs) {
                    refreshLogs();
                    flipper.setDisplayedChild(1);
                } else if (id == R.id.navigation_settings) {
                    flipper.setDisplayedChild(2);
                }
                return true;
            }
        });

        findViewById(R.id.btn_add).setOnClickListener(v -> showAddDialog());

        searchBox.addTextChangedListener(new TextWatcher() {
            @Override
            public void beforeTextChanged(CharSequence s, int a, int b, int c) {
            }

            @Override
            public void onTextChanged(CharSequence s, int a, int b, int c) {
                refreshBlocked(s.toString());
            }

            @Override
            public void afterTextChanged(Editable s) {
            }
        });

        listBlocked.setOnItemClickListener((parent, view, position, id) -> {
            String number = allBlocked.get(position)[0];
            ClipboardManager clipboard = (ClipboardManager) getSystemService(Context.CLIPBOARD_SERVICE);
            clipboard.setPrimaryClip(ClipData.newPlainText("number", number));
            Toast.makeText(this, "Copied: " + number, Toast.LENGTH_SHORT).show();
        });

        listBlocked.setOnItemLongClickListener((parent, view, position, id) -> {
            String number = allBlocked.get(position)[0];
            new AlertDialog.Builder(this)
                    .setTitle("Unblock")
                    .setMessage("Unblock " + number + " ?")
                    .setPositiveButton("Yes", (d, w) -> {
                        storage.removeBlocked(number);
                        refreshBlocked(searchBox.getText().toString());
                    })
                    .setNegativeButton("No", null)
                    .show();
            return true;
        });

        Switch switchNight = findViewById(R.id.switch_night);
        switchNight.setChecked(AppCompatDelegate.getDefaultNightMode() == AppCompatDelegate.MODE_NIGHT_YES);
        switchNight.setOnCheckedChangeListener((buttonView, isChecked) ->
                AppCompatDelegate.setDefaultNightMode(isChecked
                        ? AppCompatDelegate.MODE_NIGHT_YES
                        : AppCompatDelegate.MODE_NIGHT_NO));

        findViewById(R.id.btn_role).setOnClickListener(v -> requestCallScreenerRole());

        findViewById(R.id.btn_logout).setOnClickListener(v -> {
            TokenManager.getInstance(this).clearToken();
            startActivity(new Intent(this, LoginActivity.class));
            finish();
        });

        requestNotificationPermission();
        loadProfile();
        refreshBlocked("");
    }

    @Override
    protected void onResume() {
        super.onResume();
        refreshBlocked(searchBox.getText().toString());
        refreshLogs();
    }

    private void refreshBlocked(String query) {
        allBlocked = new ArrayList<>();
        List<String> lines = new ArrayList<>();
        for (String[] entry : storage.getAllBlocked()) {
            if (query == null || query.isEmpty() || entry[0].contains(query)) {
                allBlocked.add(entry);
                lines.add(entry[0] + "  [" + entry[1] + "]");
            }
        }
        listBlocked.setAdapter(new ArrayAdapter<>(this, android.R.layout.simple_list_item_1, lines));
    }

    private void refreshLogs() {
        listLogs.setAdapter(new ArrayAdapter<>(this, android.R.layout.simple_list_item_1, storage.getLogs()));
    }

    private void showAddDialog() {
        View dialogView = getLayoutInflater().inflate(R.layout.dialog_add_number, null);
        EditText editNumber = dialogView.findViewById(R.id.edit_number);
        Spinner spinnerLabel = dialogView.findViewById(R.id.spinner_label);
        String[] categories = {"Spam", "Nuisance", "Work", "Personal"};
        spinnerLabel.setAdapter(new ArrayAdapter<>(this, android.R.layout.simple_spinner_dropdown_item, categories));

        AlertDialog dialog = new AlertDialog.Builder(this).setView(dialogView).create();

        dialogView.findViewById(R.id.button_add).setOnClickListener(v -> {
            String number = editNumber.getText().toString().trim();
            if (!number.isEmpty()) {
                storage.addBlocked(number, categories[spinnerLabel.getSelectedItemPosition()]);
                refreshBlocked(searchBox.getText().toString());
                Toast.makeText(this, "Number blocked", Toast.LENGTH_SHORT).show();
            }
            dialog.dismiss();
        });
        dialogView.findViewById(R.id.button_cancel).setOnClickListener(v -> dialog.dismiss());
        dialog.show();
    }

    private void loadProfile() {
        String token = TokenManager.getInstance(this).getToken();
        if (token == null) return;
        progressHome.setVisibility(View.VISIBLE);
        ApiClient.fetchProfile(token, (data, error) -> runOnUiThread(() -> {
            progressHome.setVisibility(View.GONE);
            if (error != null) {
                textProfile.setText("Error: " + error);
            } else {
                textProfile.setText(data);
            }
        }));
    }

    private void requestNotificationPermission() {
        if (Build.VERSION.SDK_INT >= 33) {
            if (checkSelfPermission(Manifest.permission.POST_NOTIFICATIONS) != PackageManager.PERMISSION_GRANTED) {
                requestPermissions(new String[]{Manifest.permission.POST_NOTIFICATIONS}, 1001);
            }
        }
    }

    private void requestCallScreenerRole() {
        if (Build.VERSION.SDK_INT >= 29) {
            RoleManager roleManager = (RoleManager) getSystemService(Context.ROLE_SERVICE);
            if (roleManager != null && !roleManager.isRoleHeld(RoleManager.ROLE_CALL_SCREENER)) {
                Intent intent = roleManager.createRequestRoleIntent(RoleManager.ROLE_CALL_SCREENER);
                startActivityForResult(intent, 2001);
            } else {
                Toast.makeText(this, "Call blocking already enabled", Toast.LENGTH_SHORT).show();
            }
        } else {
            Toast.makeText(this, "Requires Android 10 or newer", Toast.LENGTH_SHORT).show();
        }
    }
}
